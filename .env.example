# ============================================================================
# Environment
# ============================================================================
# development | production
# When APP_ENV=development, all automation recipients are redirected to
# DEV_TEST_USER_EMAIL. See docs/AUTOMATION_GUIDELINES.md.
APP_ENV=development
DEV_TEST_USER_EMAIL=

# Exposed to the client so the composer can show "messages redirect to X"
# in dev. Set to the same value as DEV_TEST_USER_EMAIL. Leave blank in prod.
NEXT_PUBLIC_DEV_REDIRECT_EMAIL=

# ============================================================================
# Zoho
# ============================================================================
ZOHO_EDGE_FUNCTION_URL=

# ============================================================================
# Slack — no longer used here; each user stores their OWN tokens via /profile.
# Kept for reference / as optional bot-level admin tools later.
# ============================================================================
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=

# ============================================================================
# Supabase
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
